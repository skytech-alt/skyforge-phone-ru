// skyforge-phone-ru

функция только_цифры(значение) {
    пусть результат = ""
    для с в строка_символы(значение) {
        если цифра(с) { результат = результат + с }
    }
    вернуть результат
}

функция нормализовать_телефон(значение) {
    пусть d = только_цифры(значение)
    если длина(d) == 11 и (d[0] == "7" или d[0] == "8") {
        вернуть подстрока(d, 1, длина(d))
    }
    если длина(d) == 10 {
        вернуть d
    }
    вернуть ""
}

функция это_телефон(значение) {
    пусть d = нормализовать_телефон(значение)
    если длина(d) == 0 { вернуть ложь }
    пусть первый = d[0]
    вернуть первый == "3" или первый == "4" или первый == "8" или первый == "9"
}
